---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../data/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
---

<Base title="Blog" description="Notes on research and things I have learned.">
  <h1>Blog</h1>
  {posts.length === 0 && <p class="muted">No posts yet.</p>}
  {
    years.map((year) => (
      <section>
        <h2>{year}</h2>
        <PostList posts={posts.filter((p) => p.data.pubDate.getUTCFullYear() === year)} showDescription />
      </section>
    ))
  }
</Base>
