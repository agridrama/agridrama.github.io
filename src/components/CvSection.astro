---
import type { Entry } from '../data/cv';

interface Props {
  heading: string;
  entries: Entry[];
}

const { heading, entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section>
      <h2>{heading}</h2>
      {entries.map((e) => (
        <div class:list={['cv-entry', { 'no-period': !e.period }]}>
          {e.period && <div class="cv-period">{e.period}</div>}
          <div>
            <strong>{e.url ? <a href={e.url}>{e.title}</a> : e.title}</strong>
            {e.org && <div>{e.org}</div>}
            {e.details && (
              <ul class="muted small">
                {e.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </section>
  )
}
